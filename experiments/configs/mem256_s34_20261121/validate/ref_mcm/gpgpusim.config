# ==== mem256_s33_20261120 / validate / ref_mcm ====
# 4-chiplet MCM GPU (MCM-GPU ISCA'17 style), 256 SMs, 256 GB, 64 KB pages, trace-driven Accel-Sim.
# s33 = s32 + the model options decided on 2026-11-19 (see CHANGES.md). Arms differ only in their last block:
#   ref_mcm  first-touch placement, dumps the placement map (run it first)
#   base_mcm replays ref's map exactly (data, page-table nodes, root)
#   ptwhop0  base + zero ring hop latency for page-table-walk packets

# ---------------------------------------------------------------------------
# PTX functional simulator (not used in trace mode; kept at the Accel-Sim values)
# ---------------------------------------------------------------------------
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 86
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_compute_capability_major 8
-gpgpu_compute_capability_minor 6

# ---------------------------------------------------------------------------
# Kernel launch
# ---------------------------------------------------------------------------
# Cycles between a kernel's launch and its first CTA; per CTA launch: none.
-gpgpu_kernel_launch_latency 5000
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128
# 1 = an idle core takes its next kernel through select_kernel(), so every kernel waits the latency above.
-gpgpu_kernel_rebind 1

# ---------------------------------------------------------------------------
# GPU organisation and clocks
# ---------------------------------------------------------------------------
# 256 clusters x 1 SM, 4 chiplets (64 SMs each).
-gpgpu_n_clusters 256
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_chiplets 4
# 128 memory channels x 2 L2 slices = 256 slices (64 per chiplet, 32 channels per chiplet).
-gpgpu_n_mem 128
-gpgpu_n_sub_partition_per_mchannel 2
# <core>:<interconnect>:<L2>:<DRAM> MHz. DRAM 1.5 GHz -> 768 GB/s per chiplet (32 ch x 32 B / tCCD 2).
-gpgpu_clock_domains 1395:1395:1395:1500

# ---------------------------------------------------------------------------
# SM core (RTX 3070 / SM86 values)
# ---------------------------------------------------------------------------
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 86
# 2048 threads per SM, warp size 32; up to 32 CTAs per SM.
-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4
# "ADD,MAX,MUL,MAD,DIV" latencies / initiation intervals. In trace mode they size the unit pipelines;
# the per-instruction latencies come from trace.config.
-ptx_opcode_latency_int 4,4,4,4,21
-ptx_opcode_initiation_int 2,2,2,2,2
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 1,1,1,1,2
-ptx_opcode_latency_dp 64,64,64,64,330
-ptx_opcode_initiation_dp 64,64,64,64,130
-ptx_opcode_latency_sfu 21
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 64
-ptx_opcode_initiation_tensor 64
# Sub-core model: each of the 4 schedulers has its own register file slice and units.
-gpgpu_sub_core_model 1
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
-gpgpu_num_reg_banks 8
-gpgpu_reg_file_port_throughput 2
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

# ---------------------------------------------------------------------------
# SM model options (s33). Each is off in the code by default; see CHANGES.md for the evidence and measured effect.
# ---------------------------------------------------------------------------
# ALU results: in-order ready queue as in Accel-Sim 2.0.
-gpgpu_alu_ready_queue 1
# Atomics: a warp keeps issuing while its atomics are in flight (readers of an ATOM result still wait).
-gpgpu_trace_atomic_no_stall 1
# R255 (RZ) is the zero register, not a register operand.
-gpgpu_trace_rz_no_reg 1
# MEMBAR waits for the warp's store acks as well as its loads.
-gpgpu_membar_wait_stores 1
# .STRONG.GPU / .BYPASS stores skip the L1D like such loads (Accel-Sim 2.0).
-gpgpu_strong_store_bypass_l1 1
# LSU: L1D-bypassing accesses sent and responses taken up to -gpgpu_l1_banks per cycle (Accel-Sim 2.0).
-gpgpu_ldst_bypass_send_per_bank 1
-gpgpu_ldst_banked_response 1
# LSU translation gate: shared accesses do not take it, and a LOAD/STORE releases it once translated.
-gpgpu_ldst_gate_skip_shared 1
-gpgpu_ldst_gate_release_at_xlat 1
# LSU replay: a freed dispatch slot goes to a translated parked instruction first; stale replay ids are skipped.
-gpgpu_ldst_replay_first 1
-gpgpu_ldst_replay_skip_stale 1

# ---------------------------------------------------------------------------
# L1 data cache and shared memory (unified 128 KB per SM)
# ---------------------------------------------------------------------------
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100
-gpgpu_unified_l1d_size 128
-gpgpu_l1_banks 4
# Sectored, 4 sets x 128 B x 256 ways; LRU, write-through, allocate on miss, lazy fetch-on-read, linear index;
# 384 MSHRs merging up to 48; miss queue 16; 32 B data port.
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,16:0,32
-gpgpu_l1_latency 39
-gpgpu_gmem_skip_L1D 0
# The L1D is invalidated at kernel end and at a MEMBAR (write-through, so nothing is lost).
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 25
-gpgpu_shmem_size 102400
-gpgpu_shmem_sizeDefault 102400
-gpgpu_shmem_per_block 49152
# The driver reserves 1 KB of shared memory per CTA (sm_80 and later); counted in the CTA-per-SM limit and carveout.
-gpgpu_shmem_per_cta_reserve 1024
-gpgpu_smem_latency 29
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 86

# ---------------------------------------------------------------------------
# L2 cache (256 slices)
# ---------------------------------------------------------------------------
# Per slice: sectored, 32 sets x 128 B x 24 ways = 96 KB -> 24 MB in all, 6 MB per chiplet. LRU, write-back,
# allocate on miss, lazy fetch-on-read, IPoly set index; 192 MSHRs merging up to 4; miss queue 32; 32 B port.
-gpgpu_cache:dl2 S:32:128:24,L:B:m:L:P,A:192:4,32:0,32
-gpgpu_cache:dl2_texture_only 0
# Queue sizes: interconnect->L2, L2->DRAM, DRAM->L2, L2->interconnect.
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_l2_rop_latency 201
-dram_latency 255
# Slice index: IPoly over the 64 slices of each chiplet; the chiplet bits are not hashed (placement unchanged).
-gpgpu_memory_partition_indexing 7
-gpgpu_mem_hash_chiplets 4
# Host-to-device copies do not fill the L2.
-gpgpu_perf_sim_memcpy 0

# ---------------------------------------------------------------------------
# Instruction, texture and constant caches (perfect I/C caches: required by the trace model)
# ---------------------------------------------------------------------------
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:2:48,4
-gpgpu_inst_fetch_throughput 4
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# ---------------------------------------------------------------------------
# Interconnect: an iSLIP crossbar per chiplet (SMs <-> L2 slices) and a bidirectional ring between chiplets.
# Requests and replies use separate networks (2 subnets). config_ampere_islip.icnt is not read in this mode.
# ---------------------------------------------------------------------------
-network_mode 2
-icnt_subnets 2
-icnt_arbiter_algo 1
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_flit_size 40
# Crossbar port: 14 flits x 40 B x 1.395 GHz = 781 GB/s raw (625 GB/s of 32 B data).
-icnt_xbar_port_width 14
# SM and L2 inputs send at most one port width per cycle (the ring ingress is not limited).
-icnt_xbar_input_limit 1
# Chiplet send port to the ring: 0 = the crossbar port width.
-icnt_icp_port_width 0
# Ring: 45 cycles per hop (32 ns in MCM-GPU); 55 flits x 10 B x 1.395 GHz = 767 GB/s raw per link and direction.
-icnt_use_ring 1
-icnt_ring_hop_latency 45
-icnt_ring_link_width 55
# Ring flow control: a link starts a packet only while its wire holds fewer than width x (hop latency + 2) packets,
# and a local injection keeps one link slot free (bubble), so a blocked destination stalls the senders.
-icnt_ring_credit 1
-icnt_inter_flit_size 10
-icnt_inter_hop_latency_ns 0

# ---------------------------------------------------------------------------
# DRAM: 32 HBM3-like channels per chiplet
# ---------------------------------------------------------------------------
# FR-FCFS, 128-entry queue per channel, return queue 192.
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 128
-gpgpu_dram_return_queue_size 192
-gpgpu_n_mem_per_ctrlr 1
# 8 B bus x burst 4 = 32 B per column command; burst / ratio = 2 cycles on the data bus (HBM written as DDR).
-gpgpu_dram_buswidth 8
-gpgpu_dram_burst_length 4
-dram_data_command_freq_ratio 2
# Accel-Sim 2.0 SM90_H100 (HBM3) cycle counts used at 1.5 GHz (RCD 19 = 12.7 ns); CCD 2 and CCDL 4 kept.
# Not JEDEC values.
-gpgpu_dram_timing_opt nbk=16:CCD=2:RRD=6:RCD=19:RAS=45:RP=19:RC=50:CL=19:WL=6:CDLR=8:WR=21:nbkgrp=4:CCDL=4:RTPL=8
# Separate row and column command buses (HBM).
-dram_dual_bus_interface 1
# Bank index XORed with higher address bits; bank group from the low bank bits.
-dram_bnk_indexing_policy 1
-dram_bnkgrp_indexing_policy 1
# PA bits, MSB first: chiplet = the two top D bits (PA 36-37); D 8-12 = channel within the chiplet,
# R 20-35 row, B bank, C column, S 0-4 = 32 B burst.
-gpgpu_mem_address_mask 1
-gpgpu_mem_addr_mapping 00000000000000000000000000DDRRRRRRRRRRRRRRRRBBBCCCBDDDDDCCCSSSSS
# Device memory: 256 GB = 64 GB per chiplet.
-gpu_mem_size_mb 262144

# ---------------------------------------------------------------------------
# Address translation: per-SM L1 TLBs, per-chiplet L2 TLB and GMMU (page-table walkers, PWC)
# ---------------------------------------------------------------------------
# Every allocation uses 64 KB pages.
-gpgpu_page_size_policy 1
-gpgpu_tlb_ideal 0
# Non-blocking L1 TLB: a missing memory instruction parks and replays when translated.
-gpgpu_tlb_decouple 1
# L1 TLB lookups overlap the L1D access (VIPT); valid because every L1 TLB latency <= -gpgpu_l1_latency.
-gpgpu_l1d_vipt 1
# L1 TLB: up to 4 new lookups per cycle (pipelined, each 20 cycles). MSHR-full lookups take freed entries before new
# lookups, oldest instruction first (a warp's pages together); the per-lookup FIFO order stays off.
-gpgpu_l1_tlb_lookups_per_cycle 4
-gpgpu_l1_tlb_mshr_wait_fifo 0
-gpgpu_l1_tlb_mshr_wait_age 1
-gpgpu_l1_tlb_ports 0
# L1 TLBs per SM, fully associative; MSHR entries = TLB entries. Merge cap 1000000 = unlimited.
-gpgpu_l1_tlb_4k_sets 1
-gpgpu_l1_tlb_4k_assoc 32
-gpgpu_l1_tlb_4k_mshr_entries 32
-gpgpu_l1_tlb_4k_mshr_max_merge 1000000
-gpgpu_l1_tlb_4k_lookup_latency 20
-gpgpu_l1_tlb_64k_sets 1
-gpgpu_l1_tlb_64k_assoc 32
-gpgpu_l1_tlb_64k_mshr_entries 32
-gpgpu_l1_tlb_64k_mshr_max_merge 1000000
-gpgpu_l1_tlb_64k_lookup_latency 20
-gpgpu_l1_tlb_2m_sets 1
-gpgpu_l1_tlb_2m_assoc 8
-gpgpu_l1_tlb_2m_mshr_entries 8
-gpgpu_l1_tlb_2m_mshr_max_merge 1000000
-gpgpu_l1_tlb_2m_lookup_latency 20
# L1 -> L2 TLB: 2 new requests per SM per cycle; L2 TLB lookups unlimited per cycle.
-gpgpu_l2_tlb_issue_width 2
-gpgpu_l2_tlb_ports 0
-gpgpu_l2_tlb_starts_per_cycle 0
# A free L2 TLB MSHR entry goes to the request that has waited longest for one, whatever the SM order.
-gpgpu_l2_tlb_mshr_age_order 1
# L2 TLBs per chiplet, 8-way, XOR-folded set index; latency 80 includes the SM <-> L2 TLB round trip.
-gpgpu_l2_tlb_set_hash 1
-gpgpu_l2_tlb_sets 128
-gpgpu_l2_tlb_assoc 8
-gpgpu_l2_tlb_mshr_entries 128
-gpgpu_l2_tlb_mshr_max_merge 1000000
-gpgpu_l2_tlb_lookup_latency 80
-gpgpu_l2_tlb_64k_sets 128
-gpgpu_l2_tlb_64k_assoc 8
-gpgpu_l2_tlb_64k_mshr_entries 128
-gpgpu_l2_tlb_64k_mshr_max_merge 1000000
-gpgpu_l2_tlb_64k_lookup_latency 80
-gpgpu_l2_tlb_2m_sets 32
-gpgpu_l2_tlb_2m_assoc 8
-gpgpu_l2_tlb_2m_mshr_entries 128
-gpgpu_l2_tlb_2m_mshr_max_merge 1000000
-gpgpu_l2_tlb_2m_lookup_latency 80
# GMMU per chiplet: 32 page-table walkers, a 128-entry walk queue and a 128-entry page-walk cache.
-gmmu_n_ptw 32
-gmmu_pwq_depth 128
-gmmu_pwc_entries 128
# One page table for the GPU (1 would replicate it on every chiplet).
-gmmu_local_ptw 0

# ---------------------------------------------------------------------------
# CTA scheduling: distributed (MCM-GPU). Kernel CTAs are split into 4 contiguous chunks of ceil(N / 4),
# chunk c runs on chiplet c, and each chiplet issues its chunk in order through its own cursor.
# ---------------------------------------------------------------------------
-gpgpu_cta_scheduling_policy 2
-gpgpu_lasp_policy 4
-gpgpu_lasp_chunk_size 4
-gpgpu_cta_chiplet_cursor 1

# ---------------------------------------------------------------------------
# Run limits and statistics
# ---------------------------------------------------------------------------
-gpgpu_max_insn 10000000000
-gpgpu_memlatency_stat 14
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0
-power_simulation_enabled 0

# ---------------------------------------------------------------------------
# Arm: REFERENCE. First-touch placement; the map is written at every stats dump. Run before base and ptwhop0.
# ---------------------------------------------------------------------------
-gmmu_placement_dump ./placement_mcm.map

# ==== baseline_4k_bfs256M / ref ====
# common.config + page_4k.overlay + mode_ref.overlay
# l2_rop_latency/dram_latency corrected to Ampere SM86 values (201/255)
# generated 2026-08-15T09:46:01Z

# functional simulator specification
-gpgpu_ptx_instruction_classification 0
-gpgpu_ptx_sim_mode 0
-gpgpu_ptx_force_max_capability 86

# Device Limits
-gpgpu_stack_size_limit 1024
-gpgpu_heap_size_limit 8388608
-gpgpu_runtime_sync_depth_limit 2
-gpgpu_runtime_pending_launch_count_limit 2048
-gpgpu_kernel_launch_latency 5000
-gpgpu_TB_launch_latency 0
-gpgpu_max_concurrent_kernel 128

# Compute Capability
-gpgpu_compute_capability_major 8
-gpgpu_compute_capability_minor 6

# PTX execution-driven
-gpgpu_ptx_convert_to_ptxplus 0
-gpgpu_ptx_save_converted_ptxplus 0

# high level architecture configuration
-gpgpu_n_cores_per_cluster 1
-gpgpu_n_mem 128
-gpgpu_n_sub_partition_per_mchannel 2

# clock domains
#-gpgpu_clock_domains <Core Clock>:<Interconnect Clock>:<L2 Clock>:<DRAM Clock>
-gpgpu_clock_domains 1395:1395:1395:1000

# shader core pipeline config
-gpgpu_shader_registers 65536
-gpgpu_registers_per_block 65536
-gpgpu_occupancy_sm_number 86

-gpgpu_shader_core_pipeline 2048:32
-gpgpu_shader_cta 32
-gpgpu_simd_model 1

# Pipeline widths and number of FUs
# ID_OC_SP,ID_OC_DP,ID_OC_INT,ID_OC_SFU,ID_OC_MEM,OC_EX_SP,OC_EX_DP,OC_EX_INT,OC_EX_SFU,OC_EX_MEM,EX_WB,ID_OC_TENSOR_CORE,OC_EX_TENSOR_CORE
-gpgpu_pipeline_widths 4,4,4,4,4,4,4,4,4,4,8,4,4
-gpgpu_num_sp_units 4
-gpgpu_num_sfu_units 4
-gpgpu_num_dp_units 4
-gpgpu_num_int_units 4
-gpgpu_tensor_core_avail 1
-gpgpu_num_tensor_core_units 4

# Instruction latencies and initiation intervals
# "ADD,MAX,MUL,MAD,DIV"
# All Div operations are executed on SFU unit
-ptx_opcode_latency_int 4,4,4,4,21
-ptx_opcode_initiation_int 2,2,2,2,2
-ptx_opcode_latency_fp 4,4,4,4,39
-ptx_opcode_initiation_fp 1,1,1,1,2
-ptx_opcode_latency_dp 64,64,64,64,330
-ptx_opcode_initiation_dp 64,64,64,64,130
-ptx_opcode_latency_sfu 21
-ptx_opcode_initiation_sfu 8
-ptx_opcode_latency_tesnor 64
-ptx_opcode_initiation_tensor 64

# sub core model: in which each scheduler has its own register file and EUs
# i.e. schedulers are isolated
-gpgpu_sub_core_model 1
# disable specialized operand collectors and use generic operand collectors instead
-gpgpu_enable_specialized_operand_collector 0
-gpgpu_operand_collector_num_units_gen 8
-gpgpu_operand_collector_num_in_ports_gen 8
-gpgpu_operand_collector_num_out_ports_gen 8
# register banks
-gpgpu_num_reg_banks 8
-gpgpu_reg_file_port_throughput 2

# warp scheduling
-gpgpu_num_sched_per_core 4
-gpgpu_scheduler lrr
# a warp scheduler issue mode
-gpgpu_max_insn_issue_per_warp 1
-gpgpu_dual_issue_diff_exec_units 1

## L1/shared memory configuration
# <sector?>:<nsets>:<bsize>:<assoc>,<rep>:<wr>:<alloc>:<wr_alloc>:<set_index_fn>,<mshr>:<N>:<merge>,<mq>:**<fifo_entry>
# ** Optional parameter - Required when mshr_type==Texture Fifo
# In adaptive cache, we adaptively assign the remaining shared memory to L1 cache 
# For more info, see https://docs.nvidia.com/cuda/cuda-c-programming-guide/index.html#shared-memory-7-x 
-gpgpu_adaptive_cache_config 1
-gpgpu_shmem_option 0,8,16,32,64,100
-gpgpu_unified_l1d_size 128
# L1 cache configuration
-gpgpu_l1_banks 4
-gpgpu_cache:dl1 S:4:128:256,L:T:m:L:L,A:384:48,16:0,32
-gpgpu_l1_latency 39
-gpgpu_gmem_skip_L1D 0
-gpgpu_flush_l1_cache 1
-gpgpu_n_cluster_ejection_buffer_size 32
-gpgpu_l1_cache_write_ratio 25

# shared memory  configuration
-gpgpu_shmem_size 102400
-gpgpu_shmem_sizeDefault 102400
-gpgpu_shmem_per_block 49152
-gpgpu_smem_latency 29
# shared memory bankconflict detection 
-gpgpu_shmem_num_banks 32
-gpgpu_shmem_limited_broadcast 0
-gpgpu_shmem_warp_parts 1
-gpgpu_coalesce_arch 86

# L2 cache
# Total L2 = nsets * line * assoc * n_sub_partition = 32*128*16 * 256 = 16MB
# (MCM-GPU ISCA'17 Table 3: 16MB total, 128B lines, 16 ways -> 4MB per chiplet).
# nsets sets CAPACITY only; L2 bandwidth = n_sub_partition * per-slice rate, unchanged.
-gpgpu_cache:dl2 S:32:128:24,L:B:m:L:P,A:192:4,32:0,32
-gpgpu_cache:dl2_texture_only 0
-gpgpu_dram_partition_queues 64:64:64:64
-gpgpu_perf_sim_memcpy 0
-gpgpu_memory_partition_indexing 0

# 128 KB Inst.
-gpgpu_cache:il1 N:64:128:16,L:R:f:N:L,S:2:48,4
-gpgpu_inst_fetch_throughput 4
# 128 KB Tex
# Note, TEX is deprected since Volta, It is used for legacy apps only. Use L1D cache instead with .nc modifier or __ldg mehtod
-gpgpu_tex_cache:l1 N:4:128:256,L:R:m:N:L,T:512:8,128:2
# 64 KB Const
-gpgpu_const_cache:l1 N:128:64:8,L:R:f:N:L,S:2:64,4
-gpgpu_perfect_inst_const_cache 1

# interconnection
# use built-in local xbar
-network_mode 2
-icnt_in_buffer_limit 512
-icnt_out_buffer_limit 512
-icnt_subnets 2
# -icnt_flit_size 40
-icnt_arbiter_algo 1
-icnt_use_ring 1
-icnt_ring_hop_latency 45
-icnt_inter_hop_latency_ns 0
-icnt_ring_link_width 55
# intra-chiplet xbar per-OUTPUT-port BW = width * flit(40B) * icnt_freq(1.395GHz).
# width=5 -> 5*40*1.395 = 279 GB/s/port >= HBM2 stack (256 GB/s), so one xbar port
# can sink a chiplet's HBM2 bandwidth. Scale with DRAM BW: width ~= (DRAM/chiplet)/55.8.
-icnt_xbar_port_width 14

# memory partition latency config 
-gpgpu_l2_rop_latency 201
-dram_latency 255

# dram sched config
-gpgpu_dram_scheduler 1
-gpgpu_frfcfs_dram_sched_queue_size 64
-gpgpu_dram_return_queue_size 192

# dram model config
-gpgpu_n_mem_per_ctrlr 1
-gpgpu_dram_buswidth 2
-gpgpu_dram_burst_length 16
-dram_data_command_freq_ratio 12
-gpgpu_mem_address_mask 1
# -gpgpu_mem_addr_mapping dramid@8;00000000.00000000.00000000.00000000.0000RRRR.RRRRRRRR.RBBBCCCC.BCCSSSSS
# D must cover -gpgpu_n_mem: 7 bits = 128 channels. With 6 (DD + DDDD) only
# channels 0-63 were addressable, so sub-partitions 128-255 -- every DRAM on
# chiplets 2 and 3 -- were unreachable, and a page the PMM handed out as
# "chiplet c" physically landed on chiplet c/2. Widened D to bit 12 and took the
# bit from R (row).
# 2026-11-11 (s30): 128 GB = 4 chiplets x 32 GB. One more row bit (R 15 bits, PA bits 20-34) and the two chip
# MSBs move to PA bits 35-36 so that chip id >> 5 == PA >> 35 == the PMM's linear 32 GB-per-chiplet split
# (gpu_module::init cross-checks every frame and aborts on a mismatch). Everything below bit 20 is unchanged:
# S 0-4 (32 B burst), C 5-7, D 8-12 (32 channels per chiplet at 256 B granularity), B 13, C 14-16, B 17-19.
-gpgpu_mem_addr_mapping 000000000000000000000000000DDRRRRRRRRRRRRRRRBBBCCCBDDDDDCCCSSSSS


# Mem timing 
-gpgpu_dram_timing_opt nbk=16:CCD=2:RRD=4:RCD=14:RAS=34:RP=14:RC=48:CL=14:WL=5:CDLR=6:WR=12:nbkgrp=4:CCDL=4:RTPL=5
-dram_dual_bus_interface 0

# select lower bits for bnkgrp to increase bnkgrp parallelism
-dram_bnk_indexing_policy 0
-dram_bnkgrp_indexing_policy 1

#-dram_seperate_write_queue_enable 1
#-dram_write_queue_size 64:56:32

# stat collection
-gpgpu_memlatency_stat 14 
-gpgpu_runtime_stat 500
-enable_ptx_file_line_stats 1
-visualizer_enabled 0

# power model configs, disable it untill we create a real energy model
-power_simulation_enabled 0

# tracing functionality
#-trace_enabled 1
#-trace_components WARP_SCHEDULER,SCOREBOARD
#-trace_sampling_core 0

# MCM-GPU Configurations

# 2026-11-04 (step 17, Llama-70B distributed runs): every TLB MSHR merge cap (-gpgpu_l{1,2}_tlb_*_mshr_max_merge) is set
# to 1000000 = effectively unlimited, on the user's instruction. The simulator blocks a request when the pending list
# of its VPN reaches the cap (waiters >= cap), so 0 cannot mean unlimited; no storage is sized by the cap.
-gpgpu_n_clusters 256
-gpgpu_n_chiplets 4

-gpgpu_l1_tlb_4k_sets 1
-gpgpu_l1_tlb_4k_assoc 32
-gpgpu_l1_tlb_4k_mshr_max_merge 1000000
-gpgpu_l1_tlb_4k_lookup_latency 20
# L1 TLB (64KB): 32-entry fully-associative, 10-cycle, per-SM (2026-11-04 user setting; MCM-GPU reference config had 16).
-gpgpu_l1_tlb_64k_sets 1
-gpgpu_l1_tlb_64k_assoc 32
-gpgpu_l1_tlb_64k_mshr_max_merge 1000000
-gpgpu_l1_tlb_64k_lookup_latency 10
# L1 TLB (2MB): 8-entry fully-associative, 10-cycle, per-SM (MCM-GPU reference config).
# MSHR is not specified there, so it matches the 4KB TLB above -> page size stays
# the only variable between the two TLBs.
-gpgpu_l1_tlb_2m_sets 1
-gpgpu_l1_tlb_2m_assoc 8
-gpgpu_l1_tlb_2m_mshr_max_merge 1000000
-gpgpu_l1_tlb_2m_lookup_latency 10

# -gpgpu_page_size_policy is NOT set here: it is the swept variable, so it comes
# from configs/page_4k.overlay or page_64k.overlay and is appended at the END of
# this file. Look there, not here.
#   fixed (every alloc gets the same size): 0 = all 4KB, 1 = all 64KB, 2 = all 2MB
#   auto  (largest page with alloc size >= page size): 3 = 4KB/64KB/2MB, 4 = 4KB/2MB, 5 = 4KB/64KB
#   The experiment uses 0 and 1 only: premap runs before any cudaMalloc, so the
#   auto policies cannot be replayed and load_placement() aborts on them.
-gpgpu_tlb_decouple 1

-gpgpu_l2_tlb_sets 128
-gpgpu_l2_tlb_assoc 8
-gpgpu_l2_tlb_mshr_entries 128
-gpgpu_l2_tlb_mshr_max_merge 1000000
-gpgpu_l2_tlb_lookup_latency 80

# L2 TLB (64KB): 1024-entry (128 sets x 8-way), 80-cycle, chiplet-private (2026-11-04 user setting; was 512 = 64 sets).
-gpgpu_l2_tlb_64k_sets 128
-gpgpu_l2_tlb_64k_assoc 8
-gpgpu_l2_tlb_64k_mshr_entries 128
-gpgpu_l2_tlb_64k_mshr_max_merge 1000000
-gpgpu_l2_tlb_64k_lookup_latency 80
# L2 TLB (2MB): 256-entry (32 sets x 8-way), 80-cycle, chiplet-private.
-gpgpu_l2_tlb_2m_sets 32
-gpgpu_l2_tlb_2m_assoc 8
-gpgpu_l2_tlb_2m_mshr_entries 128
-gpgpu_l2_tlb_2m_mshr_max_merge 1000000
-gpgpu_l2_tlb_2m_lookup_latency 80
-gmmu_pwq_depth 128
-gmmu_pwc_entries 128

# Intra chiplet bandwidth
-icnt_flit_size 40
# Inter chiplet bandwidth
-icnt_inter_flit_size 10

# PMM config
# 2026-11-11 (s30): 128 GB (was 65536 = 64 GB) so that Qwen3-32B (100.5 GB) and Qwen3-30B-A3B (74 GB) at b32 x S4096 fit
-gpu_mem_size_mb 131072

#-gpgpu_deadlock_detect 0


# ============================================================================
# local-PTW A/B experiment: settings shared by ALL 24 runs.
# Anything that differs between runs lives in an overlay file, never here.
# ============================================================================

# 32 page-table walkers per chiplet. Raised from 16 so PTW throughput is not the
# first-order bottleneck; the experiment is about WHERE the walk reads from, not
# how many walks can be in flight.
-gmmu_n_ptw 32

# L1 TLB MSHR entries = that TLB's entry count (32/32/8 for 4KB/64KB/2MB), which
# is also the L1 TLB capacity in this config (sets 1 x assoc 32/32/8,
# fully-associative). mshr_entries caps the unique VPNs in flight; a returning
# fill lands in an N-entry TLB, so allowing more than N unique misses in flight
# buys thrash rather than parallelism -- the capacity is the natural ceiling.
# Sizing them by one rule also keeps the L1 TLB from being an arbitrary knob.
-gpgpu_l1_tlb_4k_mshr_entries 32
-gpgpu_l1_tlb_64k_mshr_entries 32
-gpgpu_l1_tlb_2m_mshr_entries 8

# Stated explicitly rather than left to the default: an ideal TLB would erase
# the very cost this experiment measures.
-gpgpu_tlb_ideal 0

# 2 = STATIC_BINDING: a CTA's home chiplet is cta_id % n_chiplets, a pure
# function of the CTA id. Under policy 1 the chiplet a CTA lands on depends on
# which cluster happens to be free, so -gmmu_local_ptw (a pure timing knob)
# would shift the CTA->chiplet map and confound the A/B. Identical in all runs.
-gpgpu_cta_scheduling_policy 2

# ============================================================================
# Address-translation concurrency (fix v2, docs/xlat_concurrency_fix_plan.ko.md).
# Stated explicitly even where they match the defaults: these are experiment
# conditions, and a run must be reproducible from its config alone.
# Finite lookup ports replace the previous unbounded probe concurrency; the
# issue width is the SM->L2 link width, NOT the outstanding-lookup limit
# (that is the MSHR).
# ============================================================================
-gpgpu_l1_tlb_ports 0
-gpgpu_l2_tlb_ports 0
-gpgpu_l2_tlb_issue_width 2

# 1 = every allocation is 64KB.
-gpgpu_page_size_policy 1

# ===== run 1 of 3: REFERENCE =================================================
# Places pages by first touch and dumps the map. Its own statistics are
# DISCARDED: it takes the page faults and gets the cold placement that make it
# unfair as a baseline. Must run to completion BEFORE the other two start.
-gmmu_placement_load ../ref_mcm/placement_mcm.map
# s31 (docs/s30_b32_s4096_mem128_capture_plan.ko.md section 8): replay the ref map exactly -- data PFN, PT node PFN and root -- not only the owner;
# the map must be a v3 dump from a ref run on the same tree and memory config. placement_check.map re-dumps the end state for the X-3 check
# (base takes no faults, so it must be byte-identical to ../ref_mcm/placement_mcm.map).
-gmmu_placement_exact 1
-gmmu_placement_dump ./placement_check.map
-gmmu_local_ptw 0
-gpgpu_lasp_policy 4
-gpgpu_lasp_chunk_size 4
-gpgpu_cta_chiplet_cursor 1

# instruction cap: standard 1e10 (s256_b0004_decode_layer0: 89106776 warp insn x 32 = 2851416832 thread insn < 1e10, no exception needed)
-gpgpu_max_insn 10000000000

# 2026-10-16: L2 TLB set index = XOR-fold (real NVIDIA TLBs hash; regular_exp/docs/tlb_set_hashing.ko.md). 0 = modulo as in the hash-0 rows of the table.
-gpgpu_l2_tlb_set_hash 1
-icnt_ptw_ring_hop_latency 0
